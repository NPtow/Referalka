generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id               Int       @id
  betterAuthUserId String?   @unique
  username         String?
  firstName        String
  photoUrl         String?
  createdAt        DateTime  @default(now())
  profile          Profile?
  referrer         Referrer?
  referralRequests ReferralRequest[]
  receivedReferralConnections ReferralConnection[] @relation("CandidateConnections")
  initiatedReferralConnections ReferralConnection[] @relation("ReferrerConnections")
}

model AuthUser {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      AuthAccount[]
  sessions      AuthSession[]
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Profile {
  id          String   @id @default(cuid())
  userId      Int      @unique
  companies   String[]
  vacancyLinks Json    @default("{}")
  roles       String[] @default([])
  role        String
  experience  Int
  resumeUrl   String?
  resumeFileUrl   String?
  resumeFileName  String?
  resumeFileMime  String?
  resumeFileSize  Int?
  telegramContact String?
  linkedinUrl String?
  githubUrl   String?
  siteUrl     String?
  isPro            Boolean  @default(false)
  referrals        Int      @default(0)
  bio              String?
  isPublic         Boolean  @default(false)
  shareWithMatchingReferrers Boolean @default(false)
  openToRelocation Boolean  @default(false)
  location         String?
  resumeText       String?
  applicationSubmittedAt DateTime?
  summary          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
  views            ProfileView[]
  referralConnections ReferralConnection[]
}

model ProfileView {
  id        String   @id @default(cuid())
  profileId String
  viewedAt  DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id])

  @@index([profileId])
}

model Referrer {
  id          String   @id @default(cuid())
  userId      Int      @unique
  company     String
  companies   String[] @default([])
  role        String?
  roles       String[] @default([])
  telegramContact String?
  linkedinUrl String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  referralConnections ReferralConnection[]
}

model Vacancy {
  id          String   @id @default(cuid())
  companySlug String
  title       String
  level       String
  type        String
  tags        String[]
  salary      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companySlug])
}

model ReferralRequest {
  id               String   @id @default(cuid())
  userId           Int
  companySlug      String
  companyName      String
  status           String   @default("PENDING") // PENDING | REFERRER_FOUND | PAID
  referrerName     String?
  referrerUsername  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ReferralConnection {
  id               String   @id @default(cuid())
  candidateUserId  Int
  candidateProfileId String
  referrerUserId   Int
  referrerId       String
  companyName      String
  status           String   @default("PENDING_PAYMENT")
  adminApprovalToken String @unique
  paymentRequestEmailSentAt DateTime?
  adminApprovedAt  DateTime?
  introEmailSentAt DateTime?
  createdAt        DateTime @default(now())
  candidateUser    User     @relation("CandidateConnections", fields: [candidateUserId], references: [id], onDelete: Cascade)
  candidateProfile Profile  @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  referrerUser     User     @relation("ReferrerConnections", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referrer         Referrer @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([candidateUserId, referrerUserId, companyName])
  @@index([candidateUserId, createdAt])
  @@index([referrerUserId, createdAt])
}
